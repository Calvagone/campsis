{
  "code": [
    "[MAIN]",
    "TVDUR=THETA_DUR",
    "TVVC=THETA_VC",
    "TVCL=THETA_CL",
    "",
    "DUR=TVDUR",
    "VC=TVVC * exp(ETA_VC)",
    "CL=TVCL * exp(ETA_CL)",
    "",
    "[ODE]",
    "d/dt(A_CENTRAL)=-CL/VC*A_CENTRAL",
    "",
    "[DURATION]",
    "A_CENTRAL=DUR/24.0 # day",
    "",
    "[ERROR]",
    "CONC=A_CENTRAL/VC",
    "if (CONC <= 0.001) CONC=0.001",
    "CONC_ERR=CONC*(1 + EPS_PROP_RUV)"
  ],
  "parameters": [
    {
      "name": "DUR",
      "value": 5.0,
      "label": "Duration of 0-order input",
      "type": "theta",
      "unit": "h"
    },
    {
      "name": "VC",
      "value": 10.0,
      "label": "Volume of central compartment",
      "type": "theta",
      "unit": "L"
    },
    {
      "name": "CL",
      "value": 0.3,
      "label": "Clearance",
      "type": "theta",
      "unit": "L/d"
    },
    {
      "name": "VC",
      "value": 25.0,
      "var_type": "cv%",
      "type": "omega"
    },
    {
      "name": "CL",
      "value": 25.0,
      "var_type": "cv%",
      "type": "omega"
    },
    {
      "name": "PROP_RUV",
      "value": 0.1,
      "var_type": "sd",
      "type": "sigma"
    }
  ]
}