{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 Install package from sources",
      "type": "process",
      "command": "Rscript",
      "args": ["-e", "devtools::install(build_vignettes=FALSE, dependencies=FALSE)"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📦 Roxygen",
      "type": "process",
      "command": "Rscript",
      "args": ["-e", "roxygen2::roxygenise()"],
      "group": "build",
      "problemMatcher": []
    },
	{
      "label": "🧪 Check package (R CMD Check)",
      "type": "process",
      "command": "Rscript",
      "args": ["-e", "devtools::check(cran = TRUE)"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🌐 Build pkgdown site",
      "type": "process",
      "command": "Rscript",
      "args": ["-e", "pkgdown::build_site()"],
      "options": {
        "env": {
          "NOT_CRAN": "true"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}