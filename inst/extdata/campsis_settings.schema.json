{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calvagone.github.io/campsis.doc/schema/1.0/campsis_settings.schema.json",
  "$comment": "Campsis Settings JSON Schema v1.0 © 2025 [Nicolas Luyckx / Calvagone]. Licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). You are free to share and adapt this schema with attribution.",
  "title": "Campsis Settings JSON Schema",
  "$ref": "#/$defs/settings",
  "$defs": {
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/default_settings"
          }
        ]
      }
    },
    "default_settings": {
      "type": "object",
      "properties": {
        "type": {
          "const": "default_settings"
        },
        "engine": {
          "enum": [
            "mrgsolve",
            "rxode2"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "outvars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outfuns": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/pi_outfun"
              },
              {
                "$ref": "#/$defs/stats_outfun"
              }
            ]
          }
        },
        "disabled_variabilities": {
          "type": "array",
          "items": {
            "enum": [
              "IIV",
              "RUV"
            ]
          }
        }
      },
      "required": [
        "engine",
        "seed"
      ],
      "additionalProperties": false
    },
    "pi_outfun": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pi_outfun"
        },
        "name": {
          "type": "string",
          "description": "Name of the output function (used for labeling the Campsis output). This name is optional. If not provided, the default name will be 'pi_<variable>_<pi_level>'"
        },
        "variable": {
          "type": "string",
          "description": "Variable for which the prediction interval is computed"
        },
        "pi_level": {
          "type": "number",
          "description": "Prediction interval level (between 0 and 1)"
        }
      },
      "required": [
        "type",
        "variable",
        "pi_level"
      ],
      "additionalProperties": false
    },
    "stats_outfun": {
      "type": "object",
      "properties": {
        "type": {
          "const": "stats_outfun"
        },
        "name": {
          "type": "string",
          "description": "Name of the output function (used for labeling the Campsis output). This name is optional. If not provided, the default name will be 'stats_<variable>'"
        },
        "variable": {
          "type": "string",
          "description": "Variable for which the prediction interval is computed"
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "statistics to compute. Supported: 'median', 'mean', or percentiles like 'p5', 'p95'."
        }
      },
      "required": [
        "type",
        "variable",
        "stats"
      ],
      "additionalProperties": false
    }
  }
}
